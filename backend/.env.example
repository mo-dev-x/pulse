# Copy to backend/.env and fill in. Every variable below is read in app/config.py
# (or run.py / setup_db.py). Only the "Required" block is needed to run locally.

# ── Required ─────────────────────────────────────────────
FLASK_ENV=development                 # development | production | testing
SECRET_KEY=change-me                  # python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLDATABASE=pulse_db
MYSQLUSER=root
MYSQLPASSWORD=

# ── Server ───────────────────────────────────────────────
PORT=5000
DEBUG=True
JWT_ACCESS_TOKEN_EXPIRES=86400        # seconds (24 h)
FRONTEND_URL=http://127.0.0.1:8000    # used in email links and added to CORS origins
# Comma-separated extra CORS origins
CORS_ALLOWED_ORIGINS=

# ── Email (Brevo HTTP API) — verification, password reset, notifications ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── French sentiment (Hugging Face Inference API; falls back to VADER if unset) ──
HUGGINGFACE_API_KEY=

# ── Media uploads (Cloudinary) — needed for avatars, post images, DM media ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional: background jobs (Redis + RQ); runs inline when disabled ──
BACKGROUND_JOBS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
BACKGROUND_JOB_TIMEOUT=300

# ── Optional: Meilisearch; SQL search is used when disabled ──
ENABLE_MEILISEARCH=false
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=

# ── Optional: Web Push (VAPID) ──
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# ── Optional: Université Laval OIDC / Azure Entra (feature-flagged off) ──
ENABLE_OIDC_AUTH=false
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:5000/api/auth/oidc/callback
OIDC_SCOPE=openid profile email
