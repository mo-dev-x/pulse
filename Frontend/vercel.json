{
  "version": 2,
  "routes": [
    { "src": "/", "dest": "/login.html" },
    { "src": "/feed", "dest": "/feed.html" },
    { "src": "/register", "dest": "/register.html" },
    { "src": "/verify-email", "dest": "/verify-email.html" },
    { "src": "/reset-password", "dest": "/reset-password.html" },
    { "src": "/forgot-password", "dest": "/forgot-password.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/profile", "dest": "/profile.html" },
    { "src": "/settings", "dest": "/settings.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
